# Copy to .env-docker (never commit the real file) and fill in the values.
BACKUP_APP_PORT=4934

# metadata database (job registry and run history)
BACKUP_APP_POSTGRES_PORT=2530
BACKUP_APP_POSTGRES_USER=change-me
BACKUP_APP_POSTGRES_PASSWORD=change-me
BACKUP_APP_POSTGRES_DB=backup_app
BACKUP_APP_JDBC_POSTGRES_URL=jdbc:postgresql://backup_app_postgres:5432/backup_app

# required: every API call must send this in the X-API-Key header
#   openssl rand -hex 32
BACKUP_APP_API_KEY=

# strongly recommended: encrypts stored database/cloud credentials. Keep a copy somewhere safe;
# losing it means re-registering every job.   openssl rand -base64 32
BACKUP_APP_ENCRYPTION_KEY=

# optional tuning (defaults shown)
#BACKUP_APP_MAX_CONCURRENT_BACKUPS=2
#BACKUP_APP_MAX_CONNECTIONS_PER_BACKUP=3
#BACKUP_APP_RUN_ON_STARTUP=true
#BACKUP_APP_MIN_FREE_DISK_MB=512
#BACKUP_APP_RETENTION_KEEP_LAST=0        # local archives kept per job, 0 = keep all
#BACKUP_APP_CLOUD_RETENTION_DAYS=0       # delete cloud archives older than N days, 0 = never
#BACKUP_APP_RUN_HISTORY_DAYS=90
